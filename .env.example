# Template. Copy to `.env` and put your real key in it — `.env` is gitignored, this file is not.
#
#   cp .env.example .env && chmod 600 .env    # then edit .env
#
# Only review.py reads this (carcache.py never calls an API). A real environment variable
# always wins over .env, so `ANTHROPIC_API_KEY=... review.py ...` still overrides it.
# Get a key at platform.claude.com -> Settings -> API keys.

ANTHROPIC_API_KEY=sk-ant-replace-me
